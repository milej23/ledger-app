# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/ledger

# Firebase Admin SDK service account key
# Download from: Firebase Console → Project Settings → Service accounts → Generate new private key
# Either paste the JSON content as a string, or use the path approach below:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Or provide the path to the downloaded JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

PORT=3001

# Comma-separated list of exact origins allowed to call this API from a
# browser (e.g. a web/PWA build). Not needed for the native mobile app —
# native requests don't send an Origin header and always pass through.
# Example: ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com
ALLOWED_ORIGINS=
